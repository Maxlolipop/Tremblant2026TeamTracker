# Copy this file to `.env` for local dev, and set the same two values in
# Vercel → Project → Settings → Environment Variables for the deployed site.
#
# Both come from your Supabase project: Settings → API.
#   - Project URL          → VITE_SUPABASE_URL
#   - Project API key (anon, public) → VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in a frontend — it only grants what your
# row-level-security policies allow (see supabase/schema.sql).
#
# Leave these blank/unset to run the app in single-device localStorage mode.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Per-deployment branding / defaults (both optional).
#
#   - VITE_DEFAULT_SCHEDULE_URL — the schedule page link this deployment
#     defaults to in the import form, e.g. the WBHF one:
#     https://admin.wbhfworldchampionships.com/sites/site_schedule.php?league_id=3&lang=en
#     Leave unset to default to the NBHPA Tremblant schedule.
#   - VITE_APP_TITLE — the app/header title and browser tab title,
#     e.g. "WBHF Worlds 2026". Leave unset to default to "tremblant 2026".

VITE_DEFAULT_SCHEDULE_URL=
VITE_APP_TITLE=
